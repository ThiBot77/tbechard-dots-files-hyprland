{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/avatar.png",
    "width": 22,
    "height": 11,
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 3
    }
  },
  "modules": [
    "break",
    {
      "type": "title"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────"
    },
    {
      "type": "os",
      "key": ""
    },
    {
      "type": "kernel",
      "key": ""
    },
    {
      "type": "uptime",
      "key": ""
    },
    {
      "type": "packages",
      "key": "",
      "format": "{pacman} (pacman)"
    },
    {
      "type": "shell",
      "key": ""
    },
    {
      "type": "wm",
      "key": "󰡶"
    },
    {
      "type": "terminal",
      "key": ""
    },
    {
      "type": "custom",
      "format": "──────────────────────────────"
    },
    {
      "type": "cpu",
      "key": "󰍛",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "󰚥",
      "detectionMethod": "pci"
    },
    {
      "type": "memory",
      "key": "󰾆"
    },
    {
      "type": "disk",
      "key": "",
      "folders": "/"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 3
    },
    "break"
  ]
}
