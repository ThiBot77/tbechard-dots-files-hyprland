# ── Auchan ANEE (via bastion PAM) ─────────────────────────────────────────────
Host ane-app
    HostName    access.pam.ari.internal.auchan.com
    User        XFR5203001@aucusr@hu-vm-np-ane-103.tech.internal.auchan.com

Host ane-*
    Port                        22
    PubkeyAuthentication        no
    PreferredAuthentications    keyboard-interactive,password
    StrictHostKeyChecking       no
    # Le proxy CyberArk PSM n'accepte pas le multiplexage (Invalid session state)
    ControlMaster               no
    ControlPath                 none

# ── Global defaults ───────────────────────────────────────────────────────────
Host *
    User                  debian
    IdentityFile          ~/.ssh/id_rsa
    ForwardAgent          yes
    AddKeysToAgent        yes
    ServerAliveInterval   60
    ServerAliveCountMax   3
    IdentitiesOnly        yes
    ControlMaster         auto
    ControlPath           ~/.ssh/sockets/%C
    ControlPersist        10m
