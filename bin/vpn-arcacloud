#!/usr/bin/env bash
set -euo pipefail

CONFIG="$HOME/.config/openvpn/arcacloud.ovpn"

[ -f "$CONFIG" ] || { echo "Missing $CONFIG. Run post-install.sh." >&2; exit 1; }

if ip link show tun0 >/dev/null 2>&1; then
    echo "Already connected on tun0. Close the window running it to disconnect."
    exit 0
fi

printf '\033[36mArcacloud\033[0m  password, then the Authenticator code. Ctrl+C to disconnect.\n\n'
exec sudo openvpn --config "$CONFIG"
