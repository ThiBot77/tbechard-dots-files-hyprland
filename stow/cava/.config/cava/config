[general]
mode = normal
framerate = 60
bars = 0
autosens = 1
sensitivity = 100

[input]
method = pipewire
source = auto

[output]
method = ncurses
channels = mono

[color]
# Colors come from themes/<palette>/palette.sh via theme-switch.sh, which
# regenerates ~/.config/cava/themes/current.
theme = 'current'

[smoothing]
noise_reduction = 60

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1
