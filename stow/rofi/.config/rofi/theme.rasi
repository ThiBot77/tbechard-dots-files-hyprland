* {
    bg:      rgba(0, 0, 0, 65%);
    bg-alt:  rgba(255, 255, 255, 10%);
    fg:      #ffffff;
    fg-dim:  rgba(255, 255, 255, 55%);
    accent:  #ffffff;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 32%;
    background-color: @bg;
    border: 1px;
    border-color: rgba(255, 255, 255, 15%);
    border-radius: 16px;
    padding: 12px;
}

mainbox {
    background-color: transparent;
    children: ["inputbar", "listview"];
    spacing: 10px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 10px 14px;
    children: ["entry"];
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-dim;
    text-color: @fg;
}

listview {
    background-color: transparent;
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @fg-dim;
    border-radius: 10px;
    padding: 8px 10px;
}

element selected {
    background-color: @bg-alt;
    text-color: @fg;
}

element-icon {
    size: 20px;
}
