@import "colors"

* {
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 32%;
    background-color: @bg;
    border: 1px;
    border-color: @accent;
    border-radius: 16px;
    padding: 12px;
}

mainbox {
    background-color: transparent;
    children: ["inputbar", "listview"];
    spacing: 10px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 10px 14px;
    children: ["entry"];
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-dim;
    text-color: @fg;
}

listview {
    background-color: transparent;
    lines: 8;
    spacing: 4px;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @fg-dim;
    border-radius: 10px;
    padding: 8px 10px;
}

element selected {
    background-color: @accent;
    text-color: @bg;
}

element-icon {
    size: 20px;
}
