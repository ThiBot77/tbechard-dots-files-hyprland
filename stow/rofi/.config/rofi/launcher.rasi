/**
 * App launcher — sideview layout adapted from HyDE's rofi "style_1"
 * (github.com/HyDE-Project/HyDE). Left panel shows the current wallpaper,
 * right panel the app list.
 *
 * Colors come from colors.rasi, regenerated by theme-switch.sh.
 * The wallpaper crops come from ~/.cache/hypr-wallpaper/, refreshed by
 * apply-wallpaper.sh.
 */

@import "colors"

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    display-drun:        " ";
    display-run:         " ";
    display-window:      " ";
    drun-display-format: "{name}";
    window-format:       "{w}{t}";
    font:                "Adwaita Sans 11";
    icon-theme:          "Tela";
}

window {
    height:              33em;
    width:               63em;
    transparency:        "real";
    fullscreen:          false;
    enabled:             true;
    cursor:              "default";
    spacing:             0em;
    padding:             0em;
    border:              1px;
    border-radius:       16px;
    border-color:        @accent;
    background-color:    @bg;
}

mainbox {
    enabled:             true;
    spacing:             0em;
    padding:             0em;
    orientation:         horizontal;
    children:            [ "dummywall", "listbox" ];
    background-color:    transparent;
}

dummywall {
    spacing:             0em;
    padding:             0em;
    width:               24em;
    expand:              false;
    orientation:         horizontal;
    children:            [ "mode-switcher", "inputbar" ];
    background-color:    @bg-alt;
    background-image:    url("~/.cache/hypr-wallpaper/wall.thmb.png", height);
}

mode-switcher {
    orientation:         vertical;
    enabled:             true;
    width:               3.6em;
    padding:             9.2em 0.5em 9.2em 0.5em;
    spacing:             1.2em;
    background-color:    transparent;
    background-image:    url("~/.cache/hypr-wallpaper/wall.blur.png", height);
}

button {
    cursor:              pointer;
    border-radius:       2em;
    background-color:    @bg;
    text-color:          @fg;
    font:                "FiraCode Nerd Font 14";
}

button selected {
    background-color:    @accent;
    text-color:          @bg;
}

inputbar {
    enabled:             true;
    children:            [ "entry" ];
    background-color:    transparent;
}

entry {
    enabled:             false;
}

listbox {
    spacing:             0em;
    padding:             2em;
    children:            [ "dummy", "listview", "dummy" ];
    background-color:    transparent;
}

listview {
    enabled:             true;
    spacing:             0em;
    padding:             0em;
    columns:             1;
    lines:               8;
    cycle:               true;
    dynamic:             true;
    scrollbar:           false;
    layout:              vertical;
    reverse:             false;
    expand:              false;
    fixed-height:        true;
    fixed-columns:       true;
    cursor:              "default";
    background-color:    transparent;
    text-color:          @fg;
}

dummy {
    background-color:    transparent;
}

element {
    enabled:             true;
    spacing:             0.8em;
    padding:             0.4em 0.4em 0.4em 1.2em;
    border-radius:       10px;
    cursor:              pointer;
    background-color:    transparent;
    text-color:          @fg-dim;
}

element selected.normal {
    background-color:    @accent;
    text-color:          @bg;
}

element-icon {
    size:                2.4em;
    cursor:              inherit;
    background-color:    transparent;
    text-color:          inherit;
}

element-text {
    vertical-align:      0.5;
    horizontal-align:    0.0;
    cursor:              inherit;
    background-color:    transparent;
    text-color:          inherit;
}
