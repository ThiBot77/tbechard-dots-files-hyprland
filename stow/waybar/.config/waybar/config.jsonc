{
    "layer": "top",
    "position": "top",
    "spacing": 4,
    "reload_style_on_change": true,

    "modules-left": ["custom/arch", "clock", "custom/weather", "custom/updates", "tray"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["mpris", "group/expand", "pulseaudio", "idle_inhibitor", "bluetooth", "battery", "custom/notifications", "custom/power"],

    // Tiroir natif waybar : seul "custom/expand" reste visible, le reste se
    // deplie vers la gauche au clic. Aucun script, c'est un module "group".
    "group/expand": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "transition-to-left": true,
            "click-to-reveal": true
        },
        "modules": ["custom/expand", "cpu", "memory", "user"]
    },

    "custom/expand": {
        "format": "",
        "tooltip": false
    },

    "custom/arch": {
        "format": "",
        "tooltip": false,
        "on-click": "rofi -show drun -theme ~/.config/rofi/launcher.rasi"
    },

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "",
            "active": "",
            "empty": ""
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "{:%H:%M   %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click": "gsimplecal"
    },

    "custom/weather": {
        "exec": "wttrbar --nerd --lang fr",
        "return-type": "json",
        "interval": 1800,
        "format": "{}",
        "tooltip": true
    },

    "user": {
        "interval": 60,
        "format": " {work_H}:{work_M}",
        "tooltip-format": "Uptime: {work_H}h {work_M}m {work_S}s"
    },

    "custom/updates": {
        "exec": "$HOME/.local/bin/check-updates.sh",
        "return-type": "json",
        "interval": 3600,
        "format": "{}",
        "tooltip": true,
        "on-click": "kitty --hold -e yay -Syu"
    },

    "cpu": {
        "interval": 10,
        "format": "󰍛 {usage}%",
        "format-alt": "{icon0}{icon1}{icon2}{icon3}",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
    },

    "memory": {
        "states": {
            "m": 30,
            "h": 60,
            "c": 90
        },
        "interval": 30,
        "format": "󰾆 {used}GB",
        "format-m": "󰾅 {used}GB",
        "format-h": "󰓅 {used}GB",
        "format-c": " {used}GB",
        "format-alt": "󰾆 {percentage}%",
        "tooltip-format": "󰾆 Memory usage: {percentage}%\n Used: {used:0.2f}GB / {total:0.2f}GB\n󰍛 Available: {avail:0.2f}GB\n Swap used: {swapUsed:0.2f}GB / {swapTotal:0.2f}GB ({swapPercentage}%)"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "󰁹 {capacity}%",
        "format-charging": "󰢞 {capacity}%",
        "format-warning": "󰟭 {capacity}%",
        "format-critical": "󰂎 {capacity}%",
        "format-full": "󰁹 Full",
        "tooltip-format": "{time} remaining"
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅶",
            "deactivated": "󰒲"
        },
        "tooltip-format-activated": "Veille bloquée — clic pour réactiver",
        "tooltip-format-deactivated": "Veille active — clic pour bloquer"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": " {num_connections}",
        "format-connected-battery": " {num_connections}",
        "format-icons": ["󰥇", "󰤾", "󰤿", "󰥀", "󰥁", "󰥂", "󰥃", "󰥄", "󰥅", "󰥆", "󰥈"],
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{icon} {device_battery_percentage}%",
        "on-click": "blueman-manager"
    },

    "mpris": {
        "justify": "center",
        "format": "{player_icon}   {dynamic}",
        "format-paused": "{status_icon}   {dynamic}",
        "format-stopped": "{status_icon}",
        "interval": 1,
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": " - ",
        "player-icons": {
            "default": "▶",
            "mpv": "󰎇",
            "spotify": "",
            "vlc": "󰏡"
        },
        "status-icons": {
            "paused": "",
            "playing": "",
            "stopped": ""
        },
        "max-length": 25,
        "on-click": "playerctl play-pause",
        "on-click-middle": "playerctl previous",
        "on-scroll-up": "playerctl position 1-",
        "on-scroll-down": "playerctl position 1+",
        "tooltip-format": "{title}\nby: {artist}\nPlayer: {player}"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁",
        "on-click": "pavucontrol",
        "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip-format": "{icon} {desc} // {volume}%",
        "scroll-step": 5,
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        }
    },

        "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "custom/notifications": {
        "exec": "swaync-client -swb",
        "return-type": "json",
        "escape": true,
        "exec-if": "which swaync-client",
        "format": "{icon}",
        "format-icons": {
            "notification": "󰾄",
            "none": "󰃲",
            "dnd-notification": "󰃷",
            "dnd-none": "󰃷",
            "inhibited-notification": "󰾄",
            "inhibited-none": "󰃲",
            "dnd-inhibited-notification": "󰃷",
            "dnd-inhibited-none": "󰃷"
        },
        "tooltip": true,
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip-format": "Power menu",
        "on-click": "wlogout"
    }

}
