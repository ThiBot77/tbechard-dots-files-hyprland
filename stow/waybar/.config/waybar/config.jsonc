{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["cpu", "memory", "pulseaudio", "custom/vpn", "network", "tray", "custom/power"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "default": "○",
            "active": "●",
            "empty": "○"
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M   %a %d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 5,
        "tooltip": false
    },

    "memory": {
        "format": "󰍛  {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰖁",
        "format-icons": {
            "default": "󰕾"
        },
        "on-click": "pavucontrol"
    },

    "custom/vpn": {
        "exec": "$HOME/.local/bin/vpn-status.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "networkmanager_dmenu"
    },

    "network": {
        "format-wifi": "",
        "format-ethernet": "󰈀",
        "format-linked": "󰈀 {ifname} (no IP)",
        "format-disconnected": "󰖪",
        "tooltip-format": "Network: {essid}\nSignal: {signalStrength}% ({signaldBm}dBm)\nInterface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "networkmanager_dmenu",
        "on-click-right": "nm-connection-editor"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip-format": "Power menu",
        "on-click": "wlogout"
    }
}
